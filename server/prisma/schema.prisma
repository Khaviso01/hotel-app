generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String?
  role          Role           @default(GUEST)
  createdAt     DateTime       @default(now())
  bookings      Booking[]
  favourites    Favourite[]
  reviews       Review[]
  notifications Notification[]
}

model Branch {
  id          String      @id @default(cuid())
  name        String
  city        String
  address     String
  description String
  image       String
  rating      Float       @default(4.8)
  rooms       Room[]
  reviews     Review[]
  favourites  Favourite[]
}

model Room {
  id          String    @id @default(cuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  type        String
  description String
  capacity    Int
  price       Int
  available   Boolean   @default(true)
  image       String
  bookings    Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  roomId    String
  room      Room          @relation(fields: [roomId], references: [id])
  checkIn   DateTime
  checkOut  DateTime
  guests    Int
  total     Int
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

model Favourite {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  user      User     @relation(fields: [userId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
